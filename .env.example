# ---- Required ----
# MySQL connection (local dev: root is simplest)
DATABASE_URL=mysql://root:YOUR_MYSQL_PASSWORD@127.0.0.1:3306/airline_intelligence

# Session cookie signing secret. Minimum 32 characters.
SESSION_SECRET=replace-with-at-least-32-random-characters-abcdef

# Admin account created by npm run db:setup / db:seed (password: 12+ chars)
ADMIN_EMAIL=admin@aerovista.local
ADMIN_PASSWORD=AdminDemo@2026

# ---- MongoDB (NoSQL / vector destination guides) ----
# Local:  mongodb://127.0.0.1:27017     Atlas: mongodb+srv://...
# Leave blank to run without guides (booking + analytics still work).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=airline_intelligence
# Atlas only: name of the vector index (leave blank for local MongoDB)
MONGODB_VECTOR_INDEX=
